# Supabase — https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...            # clé "anon" (publique, côté client)
SUPABASE_SERVICE_KEY=eyJ...    # clé "service_role" (serveur uniquement : cron, scraping)

# Resend (V2 — emails d'alerte). Optionnel : sans clé, pas d'email envoyé.
RESEND_API_KEY=re_...
RESEND_FROM=Hovly <onboarding@resend.dev>

# Secret des crons. Header attendu : Authorization: Bearer <CRON_SECRET>
# Endpoints : POST /api/cron/check (re-scraping des biens suivis)
#             POST /api/cron/rappels (rappels de visite)
#             POST /api/cron/veille (scan des recherches sauvegardées)
CRON_SECRET=change-me

# URL publique, utilisée dans les liens des emails de veille.
SITE_URL=https://hovly.app

# Anthropic (V3 — analyse IA)
ANTHROPIC_API_KEY=sk-ant-...

# Web Push (VAPID). Générer : npx web-push generate-vapid-keys
# Sans ces clés, le push est simplement désactivé (les emails continuent).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@hovly.app

# Temps de trajet — OpenRouteService (clé gratuite : openrouteservice.org/dev/#/signup)
# Sans clé, la fonctionnalité est désactivée (les ancres restent configurables).
ORS_API_KEY=

# Transports en commun — Transitous (https://transitous.org) : aucune clé, rien
# à configurer ici. Service communautaire, best effort, usage non commercial.
# Le jour où Hovly devient payant : basculer sur HERE Public Transit
# (5 000 requêtes/mois offertes, CB obligatoire) dans server/utils/routage.ts.
